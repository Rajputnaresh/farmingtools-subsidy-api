<script>
(function() {
  const API_ENDPOINT = window.FT_SUBSIDY_API_URL || "/api/subsidy/calculate";
  const PRIORITY_CATS = new Set(["SC", "ST", "Small", "Marginal", "Women", "NE_State", "FRA", "SHG", "FPO", "Cooperative"]);
  const PROJECT_CATS = new Set(["FPO", "Cooperative", "Rural_Youth", "FRA"]);

  function schemeToKey(code) {
    const m = {"SMAM": "SMAM", "CRM": "CRM", "CHC": "CHC", "FMB": "FMB", "NAMO_DRONE_DIDI": "NAMO_DRONE_DIDI", "RKVY": "RKVY"};
    return m[code] || code;
  }

  function getDB() {
    if (typeof window !== "undefined" && window.FULL_DB) return window.FULL_DB;
    if (typeof FULL_DB !== "undefined") return FULL_DB;
    return {};
  }

  function getStates() {
    if (typeof window !== "undefined" && window.STATES) return window.STATES;
    if (typeof STATES !== "undefined") return STATES;
    return [];
  }

  function getSchemeDocs() {
    if (typeof window !== "undefined" && window.SCHEME_DOCS) return window.SCHEME_DOCS;
    if (typeof SCHEME_DOCS !== "undefined") return SCHEME_DOCS;
    return {};
  }

  function normalizeStateKey(str) {
    if (!str) return "";
    return String(str).toUpperCase().replace(/\s+&\s+/g, '_').replace(/[\s\-().]/g, '_').replace(/__+/g, '_');
  }

  function stateCodeToName(code) {
    for (const s of getStates()) {
      if (String(s.code) === String(code)) return s.name;
    }
    return null;
  }

  function initUI() {
    populateStateDropdown();
    populateMachineDropdown("ALL");
    applyUrlParams();
    runCalculation();
    syncWithCDN();
  }

  function applyUrlParams() {
    try {
      if (typeof window === "undefined" || !window.location) return;
      var p = new URLSearchParams(window.location.search);
      var qScheme = p.get("scheme");
      var qState = p.get("state");
      var qSearch = p.get("search") || p.get("q") || "";
      var qMachine = p.get("machine");

      if (qScheme && document.getElementById("ft-scheme")) {
        document.getElementById("ft-scheme").value = qScheme;
      }

      if (qState && document.getElementById("ft-state")) {
        var stateEl = document.getElementById("ft-state");
        for (var i = 0; i < stateEl.options.length; i++) {
          if (stateEl.options[i].value.toUpperCase() === qState.toUpperCase() ||
              stateEl.options[i].textContent.toLowerCase().includes(qState.toLowerCase())) {
            stateEl.selectedIndex = i;
            break;
          }
        }
      }

      if (qSearch) {
        var sInput = document.getElementById("ft-machine-search");
        if (sInput) {
          sInput.value = qSearch;
          onSearchChange();
        }
      } else if (qMachine && document.getElementById("ft-machine")) {
        document.getElementById("ft-machine").value = qMachine;
      }
    } catch (e) {
      console.warn("Could not apply URL parameters", e);
    }
  }

  function syncWithCDN() {
    var cdnUrl = window.FT_SUBSIDY_CDN_URL || "https://rajputnaresh.github.io/farmingtools-subsidy-api/data/subsidy_master_latest.json";
    fetch(cdnUrl)
      .then(function(r) { return r.ok ? r.json() : null; })
      .then(function(data) {
        if (data && typeof data === "object") {
          window.FULL_DB = Object.assign(window.FULL_DB || {}, data);
          var curScheme = document.getElementById("ft-scheme") ? document.getElementById("ft-scheme").value : "ALL";
          var curVal = document.getElementById("ft-machine") ? document.getElementById("ft-machine").value : "";
          populateMachineDropdown(curScheme);
          if (curVal) {
            var sel = document.getElementById("ft-machine");
            if (sel) sel.value = curVal;
          }
        }
      })
      .catch(function() {});
  }

  function populateStateDropdown() {
    const sel = document.getElementById("ft-state");
    if (!sel) return;
    sel.innerHTML = '<option value="">— Central Subsidy (All India) —</option>';
    getStates().forEach(st => {
      const o = document.createElement("option");
      o.value = st.code;
      o.textContent = st.name;
      sel.appendChild(o);
    });
  }

  function populateMachineDropdown(filterScheme, searchQuery) {
    const sel = document.getElementById("ft-machine");
    if (!sel) return;
    const currentVal = sel.value;
    sel.innerHTML = "";
    const g = {};
    const db = getDB();
    const sq = (searchQuery || "").trim().toLowerCase();
    let count = 0;

    for (const mid in db) {
      const it = db[mid];
      if (filterScheme && filterScheme !== "ALL" && it.scheme !== filterScheme) continue;
      if (sq && !it.name.toLowerCase().includes(sq) && !(it.cat || "").toLowerCase().includes(sq)) continue;
      (g[it.cat] = g[it.cat] || []).push({id: mid, name: it.name, scheme: it.scheme});
      count++;
    }

    const badge = document.getElementById("ft-machine-count-badge");
    if (badge) badge.textContent = count + " available";

    for (const c in g) {
      const og = document.createElement("optgroup");
      og.label = c;
      g[c].forEach(m => {
        const o = document.createElement("option");
        o.value = m.id;
        o.textContent = m.name + " (" + m.scheme + ")";
        og.appendChild(o);
      });
      sel.appendChild(og);
    }

    if (currentVal && Array.from(sel.options).some(o => o.value === currentVal)) {
      sel.value = currentVal;
    }
  }

  window.onSchemeChange = function() {
    const sch = document.getElementById("ft-scheme").value;
    const searchEl = document.getElementById("ft-machine-search");
    const q = searchEl ? searchEl.value : "";
    populateMachineDropdown(sch, q);
    onMachineChange();
  };

  window.onSearchChange = function() {
    const sch = document.getElementById("ft-scheme").value;
    const q = document.getElementById("ft-machine-search").value;
    populateMachineDropdown(sch, q);
    onMachineChange();
  };

  window.onMachineChange = function() {
    const mid = document.getElementById("ft-machine").value;
    const db = getDB();
    const m = db[mid];
    if (m && m.pCap) {
      document.getElementById("ft-price").value = Math.round(m.pCap / (m.gPct || 0.4) / 1000) * 1000;
    }
    runCalculation();
  };

  let currentLang = "en";
  window.toggleLanguage = function() {
    currentLang = currentLang === "en" ? "hi" : "en";
    const lbl = document.getElementById("ft-lang-label");
    if (lbl) lbl.textContent = currentLang === "en" ? "हिंदी में देखें" : "View in English";
    document.querySelectorAll("[data-en]").forEach(el => {
      const txt = currentLang === "hi" ? el.getAttribute("data-hi") : el.getAttribute("data-en");
      if (txt) {
        if (el.tagName === "INPUT" && el.hasAttribute("placeholder")) el.placeholder = txt;
        else el.textContent = txt;
      }
    });
  };

  window.shareWhatsApp = function() {
    const mid = document.getElementById("ft-machine").value;
    const db = getDB();
    const m = db[mid];
    const mName = m ? m.name : "Agricultural Machine";
    const totalVal = document.getElementById("ft-res-total-val")?.textContent || "₹0";
    const farmerVal = document.getElementById("ft-res-farmer-val")?.textContent || "₹0";
    const priceVal = document.getElementById("ft-price")?.value || "0";
    const schemeBadge = document.getElementById("ft-res-scheme-badge")?.textContent || "SMAM 2024";

    const text = `🌾 *Krishi Yantra Subsidy Estimate (farmingtools.in)*\n` +
      `🚜 *Machine:* ${mName}\n` +
      `📜 *Scheme:* ${schemeBadge}\n` +
      `💰 *Dealer Price:* ₹${Number(priceVal).toLocaleString("en-IN")}\n` +
      `✅ *Total Govt Subsidy:* ${totalVal} (DBT directly to bank)\n` +
      `👤 *Farmer Net Share:* ${farmerVal}\n\n` +
      `Apply online at official portal: https://agrimachinery.nic.in/Farmer/Management/Index\n` +
      `Calculate online: https://farmingtools.in`;

    window.open("https://api.whatsapp.com/send?text=" + encodeURIComponent(text), "_blank");
  };

  window.contactDealerWhatsApp = function() {
    const mid = document.getElementById("ft-machine").value;
    const db = getDB();
    const m = db[mid];
    const mName = m ? m.name : "Agricultural Machine";
    const totalVal = document.getElementById("ft-res-total-val")?.textContent || "₹0";
    const farmerVal = document.getElementById("ft-res-farmer-val")?.textContent || "₹0";
    const priceVal = document.getElementById("ft-price")?.value || "0";
    const schemeBadge = document.getElementById("ft-res-scheme-badge")?.textContent || "SMAM 2024";
    const stateEl = document.getElementById("ft-state");
    const stateName = stateEl && stateEl.selectedIndex > 0 ? stateEl.options[stateEl.selectedIndex].text : "All India";

    const text = `🌾 *Namaste! Subsidy & Equipment Inquiry (FarmingTools.in)*\n\n` +
      `🚜 *Machine:* ${mName}\n` +
      `📍 *State:* ${stateName}\n` +
      `📜 *Scheme:* ${schemeBadge}\n` +
      `💰 *Estimated Price:* ₹${Number(priceVal).toLocaleString("en-IN")}\n` +
      `✅ *Estimated Govt Subsidy:* ${totalVal}\n` +
      `👤 *Farmer Net Share:* ${farmerVal}\n\n` +
      `Please provide empanelled dealer quotation, current delivery timeline, and DBT portal filing assistance.`;

    const phone = window.FT_DEALER_WHATSAPP || "916006078815";
    window.open("https://api.whatsapp.com/send?phone=" + phone + "&text=" + encodeURIComponent(text), "_blank");
  };

