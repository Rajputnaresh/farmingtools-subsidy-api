  function updateDocumentsListFromData(docs) {
    const list = document.getElementById("ft-docs-list");
    if (!list || !docs?.length) return;
    list.innerHTML = docs.map(d => `
      <li><span class="ft-check-icon">✓</span><div>
      <b>${d.item}</b><br>
      <span style="color:#64748b;font-size:12px;">${d.purpose || ""}</span><br>
      <a href="${d.link || "#"}" target="_blank" rel="noopener" class="ft-doc-link">Official Link ↗</a>
      </div></li>`).join("");
  }

  function updateStepsListFromData(process, statePortal) {
    const list = document.getElementById("ft-steps-list");
    if (!list || !process?.steps?.length) return;
    list.innerHTML = process.steps.map(s => `<li>${s}</li>`).join("");
  }

  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initUI);
  else initUI();
})();
</script>

</div>
{% endif %}

