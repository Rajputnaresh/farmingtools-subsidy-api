{% comment %}
  Shopify Section: Multi-Scheme Government Subsidy Calculator
  File: sections/subsidy-calculator.liquid
  Auto-generated from verified MoA&FW guidelines (2026-09-28)
  100% Free Forever, Zero Dependencies, Client-side Fallback + Optional AWS Lambda API
{% endcomment %}

{% if section.settings.enable_calculator %}
<div class="ft-calc-section-wrapper" style="width:100%;margin:0 auto;box-sizing:border-box;">
  {% if section.settings.api_url != blank %}
  <script>
    window.FT_SUBSIDY_API_URL = "{{ section.settings.api_url }}";
  </script>
  {% endif %}

<!-- ========================================================================= -->
<!-- Multi-Scheme Government Subsidy Calculator for farmingtools.in            -->
<!-- Schemes: SMAM 2024 + CRM + CHC + FMB + Namo Drone Didi + State Top-ups   -->
<!-- Drop-in compatible with Shopify Liquid Section, Theme App Block, or HTML  -->
<!-- ========================================================================= -->

<div id="farmingtools-subsidy-calculator" class="ft-calc-container">
  <div class="ft-calc-header">
    <div class="ft-header-text">
      <span class="ft-badge" data-en="GOVERNMENT SUBSIDY VERIFIED 2024-25" data-hi="सरकारी सब्सिडी सत्यापित 2024-25">GOVERNMENT SUBSIDY VERIFIED 2024-25</span>
      <h2 class="ft-title" data-en="Krishi Yantra Subsidy Calculator" data-hi="कृषि यंत्र सब्सिडी कैलकुलेटर">Krishi Yantra Subsidy Calculator</h2>
      <p class="ft-subtitle" data-en="Official Cost Norms & Subsidies: SMAM 2024, CRM (Crop Residue), Custom Hiring Centres (CHC), Farm Machinery Banks (FMB), and Namo Drone Didi." data-hi="आधिकारिक लागत मानक और अनुदान: स्माम (SMAM 2024), फसल अवशेष प्रबंधन (CRM), कस्टम हायरिंग सेंटर (CHC), फार्म मशीनरी बैंक (FMB), और नमो ड्रोन दीदी।">
        Official Cost Norms & Subsidies: <b>SMAM 2024</b>, <b>CRM (Crop Residue)</b>, <b>Custom Hiring Centres (CHC)</b>, <b>Farm Machinery Banks (FMB)</b>, and <b>Namo Drone Didi</b>.
        <span style="display:block;margin-top:4px;color:#94a3b8;font-size:11px;" data-en="175 verified machines across 6 government schemes · Source: agrimachinery.nic.in" data-hi="6 सरकारी योजनाओं में 175 सत्यापित मशीनें · स्रोत: agrimachinery.nic.in">175 verified machines across 6 government schemes · Source: agrimachinery.nic.in</span>
      </p>
    </div>
    <div class="ft-header-links">
      <button type="button" id="ft-lang-btn" onclick="toggleLanguage()" style="background:#f1f5f9;border:1px solid #cbd5e1;padding:5px 10px;border-radius:6px;font-size:12px;font-weight:600;cursor:pointer;color:#1b4d3e;margin-bottom:6px;">
        🌐 <span id="ft-lang-label">हिंदी में देखें</span>
      </button>
      <a href="https://agrimachinery.nic.in/Farmer/Management/Index" target="_blank" rel="noopener" class="ft-btn-link" data-en="Official DBT Portal ↗" data-hi="आधिकारिक डीबीटी पोर्टल ↗">Official DBT Portal ↗</a>
      <a href="https://agrimachinery.nic.in/index/ApplicationTracking" target="_blank" rel="noopener" class="ft-btn-link-subtle" data-en="Track Status ↗" data-hi="आवेदन स्थिति देखें ↗">Track Status ↗</a>
    </div>
  </div>

  <div class="ft-calc-body">
    <!-- Scheme Filter -->
    <div class="ft-form-row">
      <label class="ft-label" for="ft-scheme" data-en="Scheme Filter" data-hi="योजना फ़िल्टर">Scheme Filter</label>
      <select id="ft-scheme" class="ft-select" onchange="onSchemeChange()">
        <option value="ALL">All Government Schemes (175 Machines)</option>
        <option value="SMAM" selected>SMAM 2024 — Individual Machinery Subsidy (Tractor, Tiller, Transplanter, Harvester)</option>
        <option value="CRM">CRM — Crop Residue Management (Super Seeder, Baler, Happy Seeder, Mulcher)</option>
        <option value="NAMO_DRONE_DIDI">Namo Drone Didi & Kisan Drone (Women SHGs, FPOs & Individual Farmers)</option>
        <option value="CHC">Custom Hiring Centre (CHC) — Projects up to ₹250 Lakhs (40%–80% Subsidy)</option>
        <option value="FMB">Farm Machinery Bank (FMB) — Village Level Projects (80%–95% Subsidy)</option>
      </select>
    </div>

    <!-- Machine Selector -->
    <div class="ft-form-row">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:5px;">
        <label class="ft-label" for="ft-machine" style="margin-bottom:0;" data-en="Select Agricultural Machine / Equipment Package" data-hi="कृषि यंत्र / उपकरण पैकेज चुनें">Select Agricultural Machine / Equipment Package</label>
        <span id="ft-machine-count-badge" style="font-size:11px;color:#64748b;font-weight:600;">175 available</span>
      </div>
      <div style="margin-bottom:8px;">
        <input id="ft-machine-search" type="text" class="ft-input" placeholder="🔍 Quick search (e.g. Tractor, Super Seeder, Rotavator, Drone...)" oninput="onSearchChange()" style="font-size:12px;padding:7px 10px;">
      </div>
      <select id="ft-machine" class="ft-select" onchange="onMachineChange()">
        <!-- Populated dynamically via JS with optgroups -->
      </select>
    </div>

    <!-- 3-Column Inputs: Category, State, Price -->
    <div class="ft-grid-3">
      <div class="ft-form-group">
        <label class="ft-label" for="ft-category" data-en="Farmer / Beneficiary Category" data-hi="किसान / लाभार्थी श्रेणी">Farmer / Beneficiary Category</label>
        <select id="ft-category" class="ft-select" onchange="runCalculation()">
          <option value="SC">SC / ST / Small & Marginal / Women / NE States → 50% Priority</option>
          <option value="General" selected>General / OBC Farmer → 40% Standard</option>
          <option value="FRA">Forest Rights Act (FRA) Patta Holder → 90% Tribal Special</option>
          <option value="SHG">Women Self Help Group (DAY-NRLM) → 80% (Namo Drone / FMB)</option>
          <option value="FPO">Farmer Producer Organization (FPO) → 75%–80% Grant</option>
          <option value="Cooperative">Cooperative Society / Panchayat → 80% (FMB / CRM CHC)</option>
          <option value="Rural_Youth">Rural Youth / Entrepreneur → 40% (CHC Hubs)</option>
        </select>
      </div>

      <div class="ft-form-group">
        <label class="ft-label" for="ft-state" data-en="State / UT (for State Top-Up)" data-hi="राज्य / केंद्र शासित प्रदेश">State / UT (for State Top-Up)</label>
        <select id="ft-state" class="ft-select" onchange="runCalculation()">
          <option value="">— Central Subsidy (All India) —</option>
          <!-- 37 Indian States/UTs populated dynamically -->
        </select>
      </div>

      <div class="ft-form-group">
        <label class="ft-label" for="ft-price" data-en="Dealer Sale Price (₹)" data-hi="डीलर बिक्री मूल्य (₹)">Dealer Sale Price (₹)</label>
        <input id="ft-price" type="number" class="ft-input" value="600000" min="1000" step="1000" oninput="runCalculation()">
      </div>
    </div>

    <!-- Advanced Options Toggle -->
    <details class="ft-advanced-drawer" style="margin-bottom:14px;font-size:12px;">
      <summary style="cursor:pointer;color:#1b4d3e;font-weight:600;user-select:none;padding:2px 0;">
        ⚙️ <span data-en="Advanced Options: Quantity Units & 12% GST Treatment" data-hi="उन्नत विकल्प: मात्रा और 12% जीएसटी">Advanced Options: Quantity Units & 12% GST Treatment</span>
      </summary>
      <div style="background:#ffffff;border:1px solid #e2e8f0;border-radius:8px;padding:12px;margin-top:8px;">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          <div>
            <label class="ft-label" for="ft-units" style="font-size:12px;" data-en="Quantity / Units" data-hi="उपकरणों की संख्या">Quantity / Units</label>
            <input id="ft-units" type="number" class="ft-input" value="1" min="1" max="100" style="padding:6px 10px;font-size:12px;" oninput="runCalculation()">
          </div>
          <div>
            <label class="ft-label" style="font-size:12px;" data-en="GST Treatment (12% Agri GST)" data-hi="जीएसटी दर (12% कृषि यंत्र)">GST Treatment (12% Agri GST)</label>
            <label style="display:flex;align-items:center;gap:6px;font-size:12px;margin-top:6px;cursor:pointer;">
              <input id="ft-gst-inclusive" type="checkbox" onchange="runCalculation()">
              <span data-en="Entered price includes 12% GST" data-hi="दर्ज मूल्य में 12% जीएसटी शामिल है">Entered price includes 12% GST</span>
            </label>
          </div>
        </div>
        <div id="ft-gst-breakdown" style="display:none;margin-top:8px;padding-top:8px;border-top:1px dashed #cbd5e1;color:#475569;font-size:11px;">
          Base Machine Cost: <b id="ft-gst-base">₹0</b> + 12% GST: <b id="ft-gst-tax">₹0</b> = Total Invoice: <b id="ft-gst-total">₹0</b>
        </div>
      </div>
    </details>

    <button type="button" class="ft-calc-btn" onclick="runCalculation()" data-en="Calculate Verified Subsidy" data-hi="सब्सिडी की गणना करें">Calculate Verified Subsidy</button>
  </div>

  <!-- Subsidy Results Breakdown Card -->
  <div id="ft-result-card" class="ft-result-card" style="display:none;">
    <div class="ft-result-header">
      <h3 id="ft-res-machine-title" class="ft-res-title">Subsidy Calculation Result</h3>
      <span id="ft-res-scheme-badge" class="ft-scheme-pill">SMAM 2024</span>
    </div>

    <div class="ft-result-metrics">
      <div class="ft-metric-box ft-metric-central">
        <div class="ft-metric-label">Central Govt Subsidy</div>
        <div id="ft-res-central-val" class="ft-metric-val">₹0</div>
        <div id="ft-res-central-sub" class="ft-metric-sub">50% capped at ₹3,00,000</div>
      </div>

      <div class="ft-metric-box ft-metric-state">
        <div class="ft-metric-label">State Top-Up</div>
        <div id="ft-res-state-val" class="ft-metric-val">₹0</div>
        <div id="ft-res-state-sub" class="ft-metric-sub">Select state for top-up</div>
      </div>

      <div class="ft-metric-box ft-metric-total">
        <div class="ft-metric-label">Total Govt Assistance</div>
        <div id="ft-res-total-val" class="ft-metric-val ft-text-success">₹0</div>
        <div id="ft-res-total-sub" class="ft-metric-sub">Direct Benefit Transfer (DBT)</div>
      </div>

      <div class="ft-metric-box ft-metric-farmer">
        <div class="ft-metric-label">Farmer's Net Share</div>
        <div id="ft-res-farmer-val" class="ft-metric-val ft-text-primary">₹0</div>
        <div id="ft-res-farmer-sub" class="ft-metric-sub">Payable to empanelled dealer</div>
      </div>
    </div>

    <!-- Official Citation & Source Alert -->
    <div class="ft-citation-banner">
      <div class="ft-citation-icon">📜</div>
      <div class="ft-citation-content">
        <div id="ft-res-source" class="ft-citation-text">
          <b>Official Citation:</b> SMAM Operational Guidelines 2024 (Annexure-I) — agrimachinery.nic.in
        </div>
        <div id="ft-res-state-note" class="ft-state-note" style="display:none;"></div>
      </div>
      <a id="ft-pdf-link" href="https://agrimachinery.nic.in/Files/Guidelines/Guidelines_SMAM2024.pdf" target="_blank" rel="noopener" class="ft-pdf-badge">Official PDF ↗</a>
    </div>

    <!-- Action Buttons: WhatsApp Share, Dealer Inquiry, Print PDF, Copy Estimate -->
    <div class="ft-result-actions">
      <button type="button" class="ft-action-btn ft-btn-dealer" onclick="contactDealerWhatsApp()">
        <span>💬</span> <span data-en="Get Dealer Quote (WhatsApp)" data-hi="डीलर कोटेशन प्राप्त करें (व्हाट्सएप)">Get Dealer Quote (WhatsApp)</span>
      </button>
      <button type="button" class="ft-action-btn ft-btn-whatsapp" onclick="shareWhatsApp()">
        <span>📱</span> <span data-en="Share on WhatsApp" data-hi="व्हाट्सएप पर शेयर करें">Share on WhatsApp</span>
      </button>
      <button type="button" class="ft-action-btn ft-btn-print" onclick="window.print()">
        <span>🖨️</span> <span data-en="Print / Save PDF" data-hi="प्रिंट / पीडीएफ सेव करें">Print / Save PDF</span>
      </button>
      <button type="button" class="ft-action-btn ft-btn-copy" onclick="copyBreakdown()">
        <span>📋</span> <span id="ft-copy-btn-text" data-en="Copy Estimate" data-hi="अनुमान कॉपी करें">Copy Estimate</span>
      </button>
    </div>
  </div>

  <!-- Documents Required Accordion -->
  <details class="ft-accordion" open>
    <summary class="ft-accordion-header">
      <span>📄 Mandatory Documents Required for Application</span>
      <span class="ft-accordion-arrow">▾</span>
    </summary>
    <div class="ft-accordion-content">
      <p class="ft-accord-intro">
        Prepare clear scanned copies (PDF / JPEG under 200 KB) before applying on the official DBT portal:
      </p>
      <ul id="ft-docs-list" class="ft-checklist">
        <!-- Populated dynamically based on selected scheme and farmer category -->
      </ul>
      <div class="ft-warning-box">
        ⚠️ <b>Important Verification Rule:</b> Farmer's Name, Father's Name, and Date of Birth must <b>match Aadhaar card exactly</b>. Land Record (Khasra/Khatauni/7-12) must be in the applicant's name. Wrong caste or land entries lead to immediate disqualification at physical verification by the District Agriculture Officer.
      </div>
    </div>
  </details>

  <!-- Step-by-Step Registration & Application Process -->
  <details class="ft-accordion">
    <summary class="ft-accordion-header">
      <span>🔗 Step-by-Step Registration & Online Application Process</span>
      <span class="ft-accordion-arrow">▾</span>
    </summary>
    <div class="ft-accordion-content">
      <ol id="ft-steps-list" class="ft-steps">
        <!-- Populated dynamically -->
      </ol>
      <div class="ft-portal-links-box">
        <h4>Official Direct Government Portals:</h4>
        <div class="ft-portal-grid">
          <a href="https://agrimachinery.nic.in/Farmer/Management/Index" target="_blank" rel="noopener" class="ft-portal-card">
            <span class="ft-portal-name">Central DBT Portal</span>
            <span class="ft-portal-url">agrimachinery.nic.in/Farmer/Management/Index</span>
          </a>
          <a href="https://agrimachinery.nic.in/index/assistanceCalculator" target="_blank" rel="noopener" class="ft-portal-card">
            <span class="ft-portal-name">Official Subsidy Calculator</span>
            <span class="ft-portal-url">agrimachinery.nic.in/index/assistanceCalculator</span>
          </a>
          <a href="https://agrimachinery.nic.in/index/ApplicationTracking" target="_blank" rel="noopener" class="ft-portal-card">
            <span class="ft-portal-name">Track Application Status</span>
            <span class="ft-portal-url">agrimachinery.nic.in/index/ApplicationTracking</span>
          </a>
          <a id="ft-state-portal-card" href="https://wbfms.wb.gov.in/" target="_blank" rel="noopener" class="ft-portal-card" style="display:none;">
            <span id="ft-state-portal-title" class="ft-portal-name">State Agriculture Portal</span>
            <span id="ft-state-portal-url" class="ft-portal-url">Visit official state portal</span>
          </a>
        </div>
      </div>
    </div>
  </details>

  <!-- Footer Disclaimer -->
  <div class="ft-calc-footer">
    <span>Verified against official Ministry of Agriculture & Farmers Welfare guidelines. Updated daily via cron hash checks. No middleman charges. Subsidy released directly to bank account via DBT.</span>
  </div>
</div>

<!-- ========================================================================= -->
<!-- Stylesheet                                                                -->
<!-- ========================================================================= -->
<style>
  .ft-calc-container {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, "Helvetica Neue", sans-serif;
    max-width: 760px;
    margin: 20px auto;
    padding: 24px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    color: #1e293b;
    box-sizing: border-box;
  }
  .ft-calc-container * { box-sizing: border-box; }
  .ft-calc-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    border-bottom: 2px solid #f1f5f9;
    padding-bottom: 16px;
    margin-bottom: 20px;
    gap: 16px;
  }
  .ft-badge {
    display: inline-block;
    background: #dcfce7;
    color: #166534;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 3px 8px;
    border-radius: 4px;
    margin-bottom: 6px;
  }
  .ft-title {
    margin: 0 0 6px 0;
    font-size: 22px;
    font-weight: 700;
    color: #1b4d3e;
    line-height: 1.25;
  }
  .ft-subtitle {
    margin: 0;
    font-size: 13px;
    color: #64748b;
    line-height: 1.45;
  }
  .ft-header-links {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: flex-end;
    flex-shrink: 0;
  }
  .ft-btn-link {
    font-size: 12px;
    font-weight: 600;
    background: #1b4d3e;
    color: #ffffff !important;
    text-decoration: none;
    padding: 6px 12px;
    border-radius: 6px;
    transition: background 0.2s;
    white-space: nowrap;
  }
  .ft-btn-link:hover { background: #13392e; }
  .ft-btn-link-subtle {
    font-size: 12px;
    color: #1b4d3e;
    text-decoration: underline;
    white-space: nowrap;
  }
  .ft-calc-body {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 18px;
    margin-bottom: 20px;
  }
  .ft-form-row { margin-bottom: 14px; }
  .ft-label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: #334155;
    margin-bottom: 5px;
  }
  .ft-select, .ft-input {
    width: 100%;
    padding: 9px 12px;
    font-size: 13px;
    border: 1px solid #cbd5e1;
    border-radius: 7px;
    background-color: #ffffff;
    color: #0f172a;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .ft-select:focus, .ft-input:focus {
    outline: none;
    border-color: #1b4d3e;
    box-shadow: 0 0 0 3px rgba(27, 77, 62, 0.15);
  }
  .ft-grid-3 {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 12px;
    margin-bottom: 14px;
  }
  @media (max-width: 640px) {
    .ft-grid-3 { grid-template-columns: 1fr; }
    .ft-calc-header { flex-direction: column; align-items: flex-start; }
    .ft-header-links { align-items: flex-start; flex-direction: row; }
  }
  .ft-calc-btn {
    width: 100%;
    background: #1b4d3e;
    color: #ffffff;
    border: none;
    padding: 12px;
    font-size: 15px;
    font-weight: 700;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.2s;
  }
  .ft-calc-btn:hover { background: #13392e; }

  /* Result Card */
  .ft-result-card {
    background: #ffffff;
    border: 2px solid #1b4d3e;
    border-radius: 10px;
    padding: 18px;
    margin-bottom: 20px;
    animation: ftFadeIn 0.3s ease;
  }
  @keyframes ftFadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
  .ft-result-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #e2e8f0;
    padding-bottom: 10px;
    margin-bottom: 14px;
  }
  .ft-res-title {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
    color: #0f172a;
  }
  .ft-scheme-pill {
    background: #e0f2fe;
    color: #0369a1;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 12px;
  }
  .ft-result-metrics {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    gap: 10px;
    margin-bottom: 16px;
  }
  @media (max-width: 640px) {
    .ft-result-metrics { grid-template-columns: 1fr 1fr; }
  }
  .ft-metric-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 10px;
    text-align: center;
  }
  .ft-metric-label { font-size: 11px; color: #64748b; font-weight: 600; margin-bottom: 4px; }
  .ft-metric-val { font-size: 18px; font-weight: 800; color: #0f172a; }
  .ft-metric-sub { font-size: 10px; color: #64748b; margin-top: 3px; }
  .ft-text-success { color: #15803d !important; }
  .ft-text-primary { color: #1b4d3e !important; }

  .ft-citation-banner {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
    border-radius: 8px;
    padding: 10px 14px;
  }
  .ft-citation-icon { font-size: 20px; }
  .ft-citation-content { flex: 1; font-size: 12px; color: #065f46; line-height: 1.4; }
  .ft-state-note { font-size: 11px; color: #047857; margin-top: 3px; font-style: italic; }
  .ft-pdf-badge {
    background: #ffffff;
    border: 1px solid #6ee7b7;
    color: #065f46;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 8px;
    border-radius: 5px;
    text-decoration: none;
    white-space: nowrap;
  }
  .ft-pdf-badge:hover { background: #f0fdf4; }

  /* Accordions */
  .ft-accordion {
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    margin-bottom: 12px;
    overflow: hidden;
  }
  .ft-accordion-header {
    background: #f1f5f9;
    padding: 10px 14px;
    font-size: 13px;
    font-weight: 700;
    color: #1e293b;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    user-select: none;
  }
  .ft-accordion[open] .ft-accordion-header { background: #e2e8f0; }
  .ft-accordion-content {
    padding: 14px;
