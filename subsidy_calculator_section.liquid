      if (st) steps.splice(2, 0, `<b>State-Specific Step — Register on ${st.name}:</b> Also register your profile on <a href="${st.portal}" target="_blank" style="color:#1b4d3e;">${st.portal_name} ↗</a>. This enables access to the state quota, application for state top-up (where available), and tracking of state-level disbursement timelines.`);
