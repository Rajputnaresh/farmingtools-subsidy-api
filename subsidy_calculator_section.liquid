  window.runCalculation = function() {
    const mid = document.getElementById("ft-machine").value;
    const cat = document.getElementById("ft-category").value;
    const priceEl = document.getElementById("ft-price");
    const errEl = document.getElementById("ft-calc-error");
    const stateCode = document.getElementById("ft-state").value;
    const price = parseFloat(priceEl.value);

    if (errEl) errEl.style.display = "none";

    if (!mid) { showError("Please select an agricultural machine from the dropdown."); return; }
    if (isNaN(price) || price <= 0) { showError("Please enter a valid dealer price greater than ₹0."); priceEl.style.borderColor = "#ef4444"; return; }
    if (price > 100000000) { showError("Price seems unusually high. Please verify the dealer sale price."); priceEl.style.borderColor = "#f59e0b"; return; }
    priceEl.style.borderColor = "";

    const db = getDB();
    const m = db[mid];
    if (!m) { showError("Machine data not found. Please select a different machine."); return; }

    const isPriority = PRIORITY_CATS.has(cat);
    let pct = isPriority ? m.pPct : m.gPct;
    let cap = isPriority ? m.pCap : m.gCap;
    if (cat === "FRA" && m.scheme === "FMB") { pct = 90; cap = 2700000; }
    if (cat === "SHG" && m.scheme === "NAMO_DRONE_DIDI") { pct = 80; cap = 800000; }
    if (cat === "FPO" && m.scheme === "SMAM") { pct = 75; cap = 750000; }
    if (cat === "Cooperative" && m.scheme === "FMB") { pct = 80; cap = 2400000; }
    if (cat === "Rural_Youth" && m.scheme === "CHC") { pct = 40; cap = 10000000; }

    const unitsEl = document.getElementById("ft-units");
    const units = unitsEl ? Math.max(1, parseInt(unitsEl.value) || 1) : 1;
    const gstCheck = document.getElementById("ft-gst-inclusive");
    const isGstInclusive = gstCheck ? gstCheck.checked : false;

    let calcPrice = price;
    const gstBox = document.getElementById("ft-gst-breakdown");
    if (isGstInclusive) {
      const baseCost = Math.round(price / 1.12);
      const taxAmt = price - baseCost;
      calcPrice = baseCost;
      if (gstBox) {
        gstBox.style.display = "block";
        document.getElementById("ft-gst-base").textContent = "₹" + (baseCost * units).toLocaleString("en-IN");
        document.getElementById("ft-gst-tax").textContent = "₹" + (taxAmt * units).toLocaleString("en-IN");
        document.getElementById("ft-gst-total").textContent = "₹" + (price * units).toLocaleString("en-IN");
      }
    } else {
      if (gstBox) gstBox.style.display = "none";
    }

    const totalCost = calcPrice * units;
    const totalEffectiveCap = cap * units;
    const centralRaw = (pct / 100) * totalCost;
    const centralSubsidy = Math.min(centralRaw, totalEffectiveCap);

    let stateSubsidy = 0;
    let stateInfo = null;
    let stateNote = "";

    if (stateCode) {
      const sn = stateCodeToName(stateCode);
      if (sn) {
        const stateKey = normalizeStateKey(sn);
        const matching = (m.stateTopups || []).filter(st => normalizeStateKey(st.state) === stateKey);
        if (matching.length > 0) {
          const cs = m.scheme.toUpperCase();
          const isProj = PROJECT_CATS.has(cat);
          const score = st => {
            let s = 0;
            const ss = (st.scheme || "").toUpperCase();
            if (ss === cs) s += 100;
            if (isProj && (ss === "FMB" || ss === "CHC")) s += 50;
            if (!isProj && ss !== "FMB" && ss !== "CHC") s += 50;
            if (st.source) s += 1;
            return s;
          };
          matching.sort((a, b) => score(b) - score(a));
          const best = matching[0];
          if (matching.length === 0 || score(best) < 50) {
            // No scheme-compatible state top-up found
            stateNote = "No scheme-compatible state top-up on record — central subsidy applies";
            const sp = best.pct || 0;
            const sf = best.flat || 0;
            const sc = (sp / 100) * totalCost;
            const sa = sf > 0 ? Math.min(sc, sf * units) : sc;
            stateSubsidy = Math.min(sa, totalCost - centralSubsidy);
            stateInfo = { name: sn, pct: sp, flat: sf * units, source: best.source || "State Agriculture Department" };
            stateNote = "State Top-up: " + sp + "% (cap ₹" + (sf * units).toLocaleString("en-IN") + ") — " + (best.source || "Verified state scheme");
          }
        }
      }
    }

    const totalSubsidy = Math.min(centralSubsidy + stateSubsidy, totalCost);
    const farmerShare = Math.max(0, totalCost - totalSubsidy);

    renderResults({
      machineName: m.name, scheme: m.scheme, price: totalCost, pct: pct, cap: totalEffectiveCap,
      centralSubsidy: centralSubsidy, stateSubsidy: stateSubsidy,
      stateInfo: stateInfo, stateNote: stateNote,
      totalSubsidy: totalSubsidy, farmerShare: farmerShare,
      stateCode: stateCode, units: units,
      pdfUrl: m.sourceUrl || "https://agrimachinery.nic.in/Files/Guidelines/Guidelines_SMAM2024.pdf",
      isPriority: isPriority, farmerCategory: cat
    });

    enrichWithAPI(mid, cat, calcPrice, stateCode, units);
  };

  function showError(msg) {
    let errEl = document.getElementById("ft-calc-error");
    if (!errEl) {
      errEl = document.createElement("div");
      errEl.id = "ft-calc-error";
      errEl.style.cssText = "background:#fef2f2;border:1px solid #fca5a5;color:#991b1b;padding:10px 14px;border-radius:8px;font-size:13px;margin-bottom:14px;";
      const body = document.querySelector(".ft-calc-body");
      if (body) document.getElementById("farmingtools-subsidy-calculator").insertBefore(errEl, body);
      else document.getElementById("farmingtools-subsidy-calculator").appendChild(errEl);
    }
    errEl.textContent = "⚠️ " + msg;
    errEl.style.display = "block";
  }

  function enrichWithAPI(mid, cat, price, stateCode, units = 1) {
    fetch(API_ENDPOINT, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ machine_id: mid, farmer_category: cat, dealer_price: price, state_code: stateCode, units: units })
    })
    .then(r => r.ok ? r.json() : null)
    .then(res => {
      if (res && res.success && res.data) {
        const d = res.data;
        const srcEl = document.getElementById("ft-res-source");
        if (srcEl && d.source_citation) srcEl.innerHTML = "<b>Official Citation:</b> " + d.source_citation;
        if (d.documents_required?.length) updateDocumentsListFromData(d.documents_required);
        if (d.registration_process?.steps) updateStepsListFromData(d.registration_process, d.registration_process.state_portal);
        const badge = document.getElementById("ft-res-scheme-badge");
        if (badge && d.scheme) badge.textContent = d.scheme + " Guidelines Verified";

        // Synchronize metrics from authoritative server API response
        if (d.central) {
          const cVal = document.getElementById("ft-res-central-val");
          const cSub = document.getElementById("ft-res-central-sub");
          if (cVal) cVal.textContent = "₹" + Math.round(d.central.applicable_amount).toLocaleString("en-IN");
          if (cSub) cSub.textContent = d.central.percentage + "% (Cap: ₹" + Math.round(d.central.cap_per_unit).toLocaleString("en-IN") + ")";
        }
        if (d.state_topup) {
          const sve = document.getElementById("ft-res-state-val");
          const sse = document.getElementById("ft-res-state-sub");
          if (sve && sse) {
            if (d.state_topup.eligible) {
              sve.textContent = "₹" + Math.round(d.state_topup.applicable_amount).toLocaleString("en-IN");
              sse.textContent = "State incentive: " + (d.state_topup.percentage || 0) + "% (cap ₹" + Math.round(d.state_topup.cap_per_unit || 0).toLocaleString("en-IN") + ")";
            } else if (stateCode) {
              sve.textContent = "₹0";
              sse.textContent = "No state top-up on record — central subsidy applies";
            } else {
              sve.textContent = "₹0";
              sse.textContent = "Select state above for state top-up";
            }
          }
        }
        if (typeof d.total_subsidy !== "undefined") {
          const tVal = document.getElementById("ft-res-total-val");
          const tSub = document.getElementById("ft-res-total-sub");
          if (tVal) tVal.textContent = "₹" + Math.round(d.total_subsidy).toLocaleString("en-IN");
          if (tSub) tSub.textContent = Math.round((d.total_subsidy / (d.dealer_price || price || 1)) * 100) + "% of dealer sale price";
        }
        if (typeof d.farmer_contribution !== "undefined") {
          const fVal = document.getElementById("ft-res-farmer-val");
          if (fVal) fVal.textContent = "₹" + Math.round(d.farmer_contribution).toLocaleString("en-IN");
        }
      }
    })
    .catch(() => {});
  }

  function renderResults(d) {
    const card = document.getElementById("ft-result-card");
    if (!card) return;
    card.style.display = "block";
    const errEl = document.getElementById("ft-calc-error");
    if (errEl) errEl.style.display = "none";

    document.getElementById("ft-res-machine-title").textContent = d.machineName;
    document.getElementById("ft-res-scheme-badge").textContent = d.scheme + " Guidelines Verified";
    document.getElementById("ft-res-central-val").textContent = "₹" + Math.round(d.centralSubsidy).toLocaleString("en-IN");
    document.getElementById("ft-res-central-sub").textContent = d.pct + "% (Cap: ₹" + Math.round(d.cap).toLocaleString("en-IN") + ")";

    const sve = document.getElementById("ft-res-state-val");
    const sse = document.getElementById("ft-res-state-sub");
    if (d.stateSubsidy > 0 && d.stateInfo) {
      sve.textContent = "₹" + Math.round(d.stateSubsidy).toLocaleString("en-IN");
      sse.textContent = "State incentive: " + d.stateInfo.pct + "% (cap ₹" + d.stateInfo.flat.toLocaleString("en-IN") + ")";
    } else if (d.stateCode) {
      sve.textContent = "₹0";
      sse.textContent = "No state top-up on record — central subsidy applies";
    } else {
      sve.textContent = "₹0";
      sse.textContent = "Select state above for state top-up";
    }

    document.getElementById("ft-res-total-val").textContent = "₹" + Math.round(d.totalSubsidy).toLocaleString("en-IN");
    document.getElementById("ft-res-total-sub").textContent = Math.round((d.totalSubsidy / (d.price || 1)) * 100) + "% of dealer sale price";
    document.getElementById("ft-res-farmer-val").textContent = "₹" + Math.round(d.farmerShare).toLocaleString("en-IN");
    document.getElementById("ft-res-farmer-sub").textContent = "Farmer net out-of-pocket";

    const srcEl = document.getElementById("ft-res-source");
    srcEl.innerHTML = "<b>Official Citation:</b> Central Scheme: " + d.scheme + " Guidelines (2024-25) — Ministry of Agriculture & Farmers Welfare, GoI" +
      (d.stateNote ? "<br><span style='color:#047857;font-size:11px;'>" + d.stateNote + "</span>" : "");

    const snEl = document.getElementById("ft-res-state-note");
    if (d.stateNote) { snEl.textContent = d.stateNote; snEl.style.display = "block"; } else { snEl.style.display = "none"; }

    if (d.pdfUrl) document.getElementById("ft-pdf-link").href = d.pdfUrl;

    const spCard = document.getElementById("ft-state-portal-card");
    if (d.stateCode) {
      const st = STATES.find(s => s.code === d.stateCode);
      if (st) {
        spCard.style.display = "flex";
        spCard.href = st.portal;
        document.getElementById("ft-state-portal-title").textContent = st.name + " Agriculture Portal";
        document.getElementById("ft-state-portal-url").textContent = st.portal.replace(/^https?:\/\//, "");
      }
    } else { spCard.style.display = "none"; }

    updateDocumentsList(d.scheme, d.isPriority, d.farmerCategory);
    updateStepsList(d.scheme, d.stateCode);
  }

